APP_NAME=Commerce Platform API
APP_ENV=local
APP_VERSION=0.1.0
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_REGISTRATION_INVITE_CODE=local-admin-invite-code
NEXT_PUBLIC_API_BASE_URL=
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:55432/commerce
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_PORT=55432
